<?php

/**
 * @file
 * Update hooks for ICMS Location bundle.
 */

use Drupal\Core\StringTranslation\TranslatableMarkup;
use Symfony\Component\Yaml\Yaml;

/**
 * Implements hook_install().
 *
 * Sets the module weight to 50 to ensure deployment hooks run in the
 * correct order after core modules.
 */
function icms_bundle_location_logic_install() {
  module_set_weight('icms_bundle_location_logic', 50);

  // Import default bundle texts on module installation.
  icms_bundle_location_logic_import_default_texts();
}

/**
 * Imports default text entities from the package-local texts file.
 */
function icms_bundle_location_logic_import_default_texts(): void {
  $module_name = 'icms_bundle_location_logic';
  $module_handler = \Drupal::moduleHandler();

  if (!$module_handler->moduleExists('texts') || !$module_handler->moduleExists('texts_sync')) {
    \Drupal::logger($module_name)->notice('Skipped texts import during install because texts/texts_sync is not enabled.');
    return;
  }

  $module_path = \Drupal::service('extension.list.module')->getPath($module_name);
  $texts_file = DRUPAL_ROOT . '/' . $module_path . '/texts/texts.yml';

  if (!is_readable($texts_file)) {
    \Drupal::logger($module_name)->notice('Skipped texts import during install because no readable texts file was found at @path.', ['@path' => $texts_file]);
    return;
  }

  try {
    $data = Yaml::parseFile($texts_file);
    if (!is_array($data) || empty($data)) {
      \Drupal::logger($module_name)->warning('Skipped texts import during install because YAML was empty or invalid: @path', ['@path' => $texts_file]);
      return;
    }

    /** @var \Drupal\texts_sync\TextsSyncService $texts_sync */
    $texts_sync = \Drupal::service('texts_sync.service');
    $stats = $texts_sync->import($data, NULL, FALSE);

    \Drupal::logger($module_name)->notice('Imported default texts during install. Created: @created, Updated: @updated, Skipped: @skipped.', [
      '@created' => (int) ($stats['created'] ?? 0),
      '@updated' => (int) ($stats['updated'] ?? 0),
      '@skipped' => (int) ($stats['skipped'] ?? 0),
    ]);
  }
  catch (\Throwable $e) {
    \Drupal::logger($module_name)->error('Failed to import default texts during install: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Let editors choose the original language of locations.
 *
 * Mirrors the recipe: the language selector is enabled for the content type
 * and placed above the form tabs. The shared helper lives in icms_core_logic,
 * which every ICMS site has installed.
 */
function icms_bundle_location_logic_update_9001() {
  \Drupal::moduleHandler()->loadInclude('icms_core_logic', 'install');
  if (!function_exists('_icms_core_logic_enable_original_language_selection')) {
    return (string) new TranslatableMarkup('Skipped: icms_core_logic is missing the language selection helper, update it first.');
  }

  $messages = _icms_core_logic_enable_original_language_selection('node', 'icms_location');
  if (!$messages) {
    return (string) new TranslatableMarkup('The original language of locations was already selectable.');
  }
  return implode(' ', $messages);
}

/**
 * Location map: set the coordinates from a geocoder result.
 *
 * Geolocation 4.1 only places the marker and fills lat/lng for a picked
 * address when the widget's "Set result on geocode" setting is on, which
 * defaults to off. The location form hides the lat/lng inputs, so without it
 * the coordinates can only be set by clicking the map.
 */
function icms_bundle_location_logic_update_9002() {
  $form_display_id = 'node.icms_location.default';
  /** @var \Drupal\Core\Entity\Display\EntityFormDisplayInterface|null $display */
  $display = \Drupal::entityTypeManager()->getStorage('entity_form_display')->loadOverrideFree($form_display_id);
  $component = $display?->getComponent('field_icms_coordinates');
  if (($component['type'] ?? NULL) !== 'geolocation_map') {
    return (string) new TranslatableMarkup('Skipped: the location form has no geolocation map widget for the coordinates.');
  }
  if (!empty($component['settings']['set_result_on_geocode'])) {
    return (string) new TranslatableMarkup('The location map already sets the coordinates from a geocoder result.');
  }

  $component['settings']['set_result_on_geocode'] = TRUE;
  $display->setComponent('field_icms_coordinates', $component)->save();
  return (string) new TranslatableMarkup('The location map now sets the coordinates from a geocoder result.');
}
